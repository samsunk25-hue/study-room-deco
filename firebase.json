{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "js/units.js",
      "gas/**",
      "README.md",
      "*.docx",
      "*.hwp",
      "*.pdf"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Content-Security-Policy", "value": "connect-src https://script.google.com https://script.googleusercontent.com; form-action 'none'; object-src 'none'; base-uri 'none'" }
        ]
      }
    ]
  }
}
